# ============================================================
# Kantar Otomasyonu — .gitignore
# ============================================================

# ── Editör & IDE ─────────────────────────────────────────────
.vscode/sftp.json
.vscode/ftp-simple-temp.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── İşletim Sistemi ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Log Dosyaları ────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Ortam Değişkenleri ───────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.*

# ── Node.js (gelecekte eklenirse) ────────────────────────────
node_modules/
dist/
build/

# ── Python (gelecekte eklenirse) ─────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# ── Yedek / Geçici Dosyalar ──────────────────────────────────
*.bak
*.tmp
*.temp
*.swp
*~
